-- Generated by tools/city_colliders.py. Invisible collision boxes per city building, in the
-- model's Roblox space (studs); Server/CityBuildings builds them. One child ModuleScript per model
-- ({ ref, refMin, refMax, data }), its boxes packed in base64 (scripts are capped at 200k chars).
-- CityColliders[ModelName] -> { ref, refMin, refMax, boxes } (decoded on first use), where a box is
-- { cx, cy, cz, sx, sy, sz, material [, r00, r01, r02, r10, r11, r12, r20, r21, r22] }.
-- material: 0 Concrete, 1 Grass, 2 Asphalt, 3 Wood, 4 Metal, 5 Glass, 6 Slate, 7 Plastic, 8 Ground, 9 Brick, 10 Granite

local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local LUT = {}
for i = 1, 64 do
	LUT[string.byte(ALPHABET, i)] = i - 1
end

local function fromBase64(s: string): buffer
	local n = #s
	local pad = if string.sub(s, -2) == "==" then 2 elseif string.sub(s, -1) == "=" then 1 else 0
	local size = n // 4 * 3 - pad
	local out = buffer.create(size)
	local o = 0
	for i = 1, n, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local v = LUT[a] * 262144 + LUT[b] * 4096 + (LUT[c] or 0) * 64 + (LUT[d] or 0)
		buffer.writeu8(out, o, v // 65536)
		if o + 1 < size then
			buffer.writeu8(out, o + 1, (v // 256) % 256)
		end
		if o + 2 < size then
			buffer.writeu8(out, o + 2, v % 256)
		end
		o += 3
	end
	return out
end

local function decode(raw: any)
	local buf = fromBase64(raw.data)
	local boxes = {}
	local o, len = 0, buffer.len(buf)
	while o < len do
		local mat, turned = buffer.readu8(buf, o), buffer.readu8(buf, o + 1)
		local box = { 0, 0, 0, 0, 0, 0, mat }
		for k = 0, 5 do
			box[k + 1] = buffer.readf32(buf, o + 2 + k * 4)
		end
		o += 26
		if turned == 1 then
			local qx, qy, qz, qw =
				buffer.readi16(buf, o),
				buffer.readi16(buf, o + 2),
				buffer.readi16(buf, o + 4),
				buffer.readi16(buf, o + 6)
			o += 8
			local m = math.sqrt(qx * qx + qy * qy + qz * qz + qw * qw)
			local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 =
				CFrame.new(0, 0, 0, qx / m, qy / m, qz / m, qw / m):GetComponents()
			for _, r in { r00, r01, r02, r10, r11, r12, r20, r21, r22 } do
				table.insert(box, r)
			end
		end
		table.insert(boxes, box)
	end
	return { ref = raw.ref, refMin = raw.refMin, refMax = raw.refMax, boxes = boxes }
end

local cache = {}
return setmetatable({}, {
	__index = function(_, key)
		if cache[key] == nil then
			local mod = type(key) == "string" and script:FindFirstChild(key)
			cache[key] = if mod and mod:IsA("ModuleScript") then decode(require(mod) :: any) else false
		end
		return cache[key] or nil
	end,
})
